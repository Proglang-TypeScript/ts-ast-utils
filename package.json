{
  "name": "@proglang/ts-ast-utils",
  "version": "1.7.0",
  "description": "Utilities for TypeScript AST traversals",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "node node_modules/typescript/lib/tsc.js",
    "test": "jest",
    "test:clear-cache": "jest --clearCache",
    "lint": "eslint --max-warnings 0 'src/**/*.ts'",
    "prettier": "prettier --write 'src/**/*.ts'",
    "script": "ts-node",
    "prepublishOnly": "npm run build",
    "package:local": "npm run build && npm pack && mkdir -p packages.local && mv ./proglang-ts-ast-utils*.tgz packages.local/",
    "release": "release-it"
  },
  "keywords": [
    "typescript",
    "ast"
  ],
  "author": "fcristiani",
  "license": "BSD-3-Clause",
  "repository": {
    "url": "git://github.com/proglang/ts-ast-utils.git"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.6.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "prettier": "3.9.6",
    "pretty-quick": "4.2.2",
    "release-it": "21.0.3",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "globals": "17.12.0",
    "@eslint/js": "10.0.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
